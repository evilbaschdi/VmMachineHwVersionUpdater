<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageRestore>
		<add key="enabled" value="True" />
		<add key="automatic" value="True" />
	</packageRestore>

	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="SWalter Labs" value="https://www.myget.org/F/swalterlabs/api/v3/index.json" />
	</packageSources>

	<!-- Define mappings by adding package patterns beneath the target source. -->
	<!-- EvilBaschdi.* packages will be restored from EvilBaschdiCodeberg, everything else from nuget.org. -->
	<packageSourceMapping>
		<!-- key value for <packageSource> should match key values from <packageSources> element -->
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="SWalter Labs">
			<package pattern="SWalter.*" />
		</packageSource>
	</packageSourceMapping>

</configuration>